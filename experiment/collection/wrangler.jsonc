{
  "name": "zendo-og1-ranked-collector",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-05-22",
  "workers_dev": true,
  "vars": { "ENVIRONMENT": "production", "ALLOWED_ORIGIN": "https://danajarutar.github.io", "GITHUB_REPOSITORY": "danajarutar/zendo-og1-ranked-responses", "ARCHIVE_KEY_ID": "og1-ranked-production-1" },
  "durable_objects": { "bindings": [{ "name": "COLLECTOR", "class_name": "StudyCollector" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["StudyCollector"] }],
  "observability": { "enabled": false }
}
